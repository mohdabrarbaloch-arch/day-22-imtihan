# ---- Imtihan environment configuration ----
# Copy to .env and fill in real values. NEVER commit .env.

# App
APP_NAME=Imtihan
APP_VERSION=1.0.0
DEBUG=false

# Database
# SQLite (dev):
DATABASE_URL=sqlite:///./imtihan.db
# PostgreSQL (prod / docker-compose):
# DATABASE_URL=postgresql+psycopg2://imtihan:imtihan@db:5432/imtihan

# Auth — CHANGE THIS IN PRODUCTION (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated origins, or * for all (dev only)
ALLOWED_ORIGINS=*

# Rate limits
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SUBMIT=10/minute

# Exam codes
EXAM_CODE_TTL_DAYS=30
